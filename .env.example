# Copiá este archivo a .env para desarrollo local (NO subir .env al repo).

# Conexión a PostgreSQL
DATABASE_URL=postgres://usuario:password@localhost:5432/tribuneros

# Puerto del server
PORT=3000

# Contraseña única de acceso a la app y la API.
# Si se deja vacía, la app queda abierta (sin login).
APP_PASSWORD=cambiame
